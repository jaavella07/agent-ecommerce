{
  "name": "agent-ecommerce",
  "version": "1.0.0",
  "description": "Super Agente E-commerce",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:server": "tsx src/server.ts",
    "studio": "npx @langchain/langgraph-cli dev",
    "studio:port": "npx @langchain/langgraph-cli dev --port 2024",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/langgraph-checkpoint": "^1.0.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/ollama": "^1.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "pg": "^8.13.3",
    "zod": "^4.3.6"
  }
}
